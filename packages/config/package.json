{
  "name": "@hf/config",
  "version": "0.0.0",
  "private": true,
  "description": "Configuración compartida: tsconfig, ESLint y Prettier",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
