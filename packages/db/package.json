{
  "name": "@hf/db",
  "version": "0.0.0",
  "private": true,
  "description": "Infraestructura de datos: esquema Drizzle, migraciones y repositorios",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@hf/application": "workspace:*",
    "@hf/domain": "workspace:*"
  },
  "devDependencies": {
    "@hf/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
