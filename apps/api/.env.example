# Variables de entorno de apps/api (HouseFinance).
# Copia este archivo a `.env` para desarrollar en local y rellénalo con los valores reales.
# Los valores reales NUNCA se suben al repositorio: en producción viven en Vercel (proyecto de la API)
# y, la de migraciones, en los secretos de GitHub Actions. Guía completa: docs/supabase.md

# --- Supabase Auth (solo la API habla con Supabase) ---

# URL del proyecto: https://<reference-id>.supabase.co
# Supabase → Project Settings → General (Reference ID) o el diálogo Connect.
SUPABASE_URL=

# Clave pública (sb_publishable_...). Supabase → Project Settings → API Keys.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...). Acceso total al proyecto: solo en el servidor, nunca con NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys.
SUPABASE_SECRET_KEY=

# --- Base de datos (Postgres de Supabase, Frankfurt) ---

# Conexión de la API en ejecución: Transaction pooler (puerto 6543), pensado para funciones serverless.
# Supabase → Connect → Transaction pooler. Sustituye [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=

# Conexión para las migraciones de drizzle-kit: Session pooler (puerto 5432), accesible por IPv4.
# Supabase → Connect → Session pooler. También es un secreto de GitHub Actions.
MIGRATIONS_DATABASE_URL=

# --- Job diario y CORS ---

# Secreto con el que Vercel Cron llama a GET /v1/jobs/daily-close. Genéralo con: openssl rand -hex 32
CRON_SECRET=

# Origen de la web, el único que permite CORS (sin barra final). En local: http://localhost:3000
WEB_ORIGIN=
